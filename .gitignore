# Dependencies and generated build/test output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local application state (credentials, sessions, history, and encryption key).
# data/northwind is the checked-in sample schema the tests and the extractor
# use, so it stays tracked - everything else under data/ is runtime state.
/data/*
!/data/northwind/

# Generated UI captures and layout assets
/.snapshot/
/scripts/ui-layout/app.css
/scripts/ui-layout/*.png

# Local environment files; allow sanitized templates
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local AI tooling and installed agent skills
/.mimosa/
/.zcode/
/.agents/skills/
/.workbuddy-ai/

# Generated local command output and verification responses
/.gate-out.txt
/.lint-out.txt
/.measure-out.txt
/.vitest-out.txt
/.verify-resp.json
/.secret.key
/.repro-data/
/graphify-out/
*.log
*.tmp

# OS and editor temporary files
.DS_Store
Thumbs.db
*~
*.swp
*.swo
